version: "3.8"

services:
  events-db:
    image: mysql:8.0
    container_name: events-db
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: events_db
      MYSQL_USER: user
      MYSQL_PASSWORD: password
    ports:
      - "3307:3306" 
    volumes:
      - events-db-data:/var/lib/mysql
    networks:
      - app-network

  events-phpmyadmin:
    image: phpmyadmin/phpmyadmin
    container_name: events-phpmyadmin
    restart: always
    environment:
      PMA_HOSTS: events-db,gamificacao-db
      PMA_PORT: 3306
    ports:
      - "8082:80"
    depends_on:
      - events-db
      - gamificacao-db
    networks:
      - app-network

  events-api:
    container_name: events-api
    build:
      context: ./events-api
      dockerfile: Dockerfile
    restart: on-failure
    environment:
      SPRING_DATASOURCE_URL: jdbc:mysql://events-db:3306/events_db
      SPRING_DATASOURCE_USERNAME: user
      SPRING_DATASOURCE_PASSWORD: password
    ports:
      - "8081:8081"
    depends_on:
      - events-db
    volumes:
      - ./events-api/src:/app/src
    networks:
      - app-network

  gamificacao-db:
    image: mysql:8.0
    container_name: gamificacao-db
    environment:
      MYSQL_ROOT_PASSWORD: senha
      MYSQL_DATABASE: gamificacao_db
      MYSQL_USER: user
      MYSQL_PASSWORD: password
    ports:
      - "3308:3306"
    volumes:
      - gamificacao-db-data:/var/lib/mysql
    restart: always
    networks:
      - app-network

  gamificacao-app:
    build:
      context: ./gamificacao-service 
      dockerfile: Dockerfile
    container_name: gamificacao-app
    ports:
      - "8085:8085"
    depends_on:
      - gamificacao-db
    environment:
      SPRING_DATASOURCE_URL: jdbc:mysql://gamificacao-db:3306/gamificacao_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
      SPRING_DATASOURCE_USERNAME: user
      SPRING_DATASOURCE_PASSWORD: password
      SERVER_PORT: 8085
    networks:
      - app-network

volumes:
  events-db-data:
  gamificacao-db-data:

networks:
  app-network:
    driver: bridge
